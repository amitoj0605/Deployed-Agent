{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Run AgentRAG",
            "type": "python",
            "request": "launch",
            "program": "${workspaceFolder}/run_app.py",
            "python": "${workspaceFolder}/venv/bin/python",
            "cwd": "${workspaceFolder}",
            "env": {
                "PYTHONPATH": "${workspaceFolder}"
